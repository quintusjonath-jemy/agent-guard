{
  "name": "AgentGuard Protected Autonomous Agent Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agent-webhook",
        "options": {}
      },
      "id": "1",
      "name": "Incoming Agent Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/execute",
        "authentication": "none",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "ag_live_demo_key_secret_hash"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent_id: ($json.body && $json.body.agent_id) ? $json.body.agent_id : ($json.agent_id || 2), tool: ($json.body && $json.body.tool_name) ? $json.body.tool_name : ($json.tool_name || $json.tool || 'customer.read'), action: ($json.body && $json.body.action_name) ? $json.body.action_name : ($json.action_name || $json.action || 'read'), payload: ($json.body && $json.body.payload) ? $json.body.payload : ($json.payload || {}) }) }}"
      },
      "id": "2",
      "name": "AgentGuard Security Firewall",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.data.decision }}",
              "value2": "ALLOWED"
            }
          ]
        }
      },
      "id": "3",
      "name": "Evaluate Guard Decision",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [720, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, decision: $json.data.decision, tool_response: $json.data.response_payload, execution_id: $json.data.execution_id } }}"
      },
      "id": "4",
      "name": "Proceed With Action Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [960, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, decision: $json.data.decision, risk_score: $json.data.risk_score, reason: $json.data.reason } }}",
        "options": {
          "responseCode": 403
        }
      },
      "id": "5",
      "name": "Block Unsafe Agent Action",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [960, 420]
    }
  ],
  "connections": {
    "Incoming Agent Request": {
      "main": [
        [
          {
            "node": "AgentGuard Security Firewall",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AgentGuard Security Firewall": {
      "main": [
        [
          {
            "node": "Evaluate Guard Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Guard Decision": {
      "main": [
        [
          {
            "node": "Proceed With Action Result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Block Unsafe Agent Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
