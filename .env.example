# Root Environment Configuration for AgentGuard

APP_ENV=development
APP_NAME=AgentGuard
API_PREFIX=/api/v1
PORT=8000

# Security & JWT
JWT_SECRET=super-secret-agentguard-jwt-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agentguard_db
MYSQL_USER=agentguard_user
MYSQL_PASSWORD=agentguard_secure_password
MYSQL_ROOT_PASSWORD=root_secure_password

# Database URL for SQLAlchemy (PyMySQL driver)
DATABASE_URL=mysql+pymysql://agentguard_user:agentguard_secure_password@localhost:3306/agentguard_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional Integrations
OPENAI_API_KEY=
N8N_WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO
